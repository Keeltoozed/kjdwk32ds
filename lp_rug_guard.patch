index 0000000..44b1046
--- /dev/null
+++ b/analyze_pnl_path.py
@@ -0,0 +1,103 @@
+"""Анализ таблицы trade_pnl_path: что было бы, если выходить на N-й минуте.
+
+Запуск:
+    python analyze_pnl_path.py                      # читает таблицу trade_pnl_path из Supabase
+    python analyze_pnl_path.py pnl_path_log.jsonl   # или локальный файл (выгрузка json/jsonl)
+
+Важно: кривая PnL — брутто (без комиссий DEX), итог pnl_pct — нетто. Для сравнения вариантов это нормально,
+но абсолютные цифры чуть выше реальных. Выводы делайте от 20-30+ сделок, на 5-10 это шум.
+"""
+import json
+import statistics as st
+import sys
+from collections import defaultdict
+
+MARKS = (5, 10, 15, 20)
+EXIT_AT = (8, 10, 12, 15, 18, 20)
+
+
+def load():
+    if len(sys.argv) > 1:
+        path = sys.argv[1]
+        with open(path, encoding="utf-8") as f:
+            txt = f.read().strip()
+        if txt.startswith("["):
+            return json.loads(txt)
+        return [json.loads(line) for line in txt.splitlines() if line.strip()]
+    import config
+    from supabase import create_client
+    sb = create_client(config.SUPABASE_URL, config.SUPABASE_KEY)
+    rows, off = [], 0
+    while True:
+        chunk = sb.table("trade_pnl_path").select("*").range(off, off + 999).execute().data or []
+        rows += chunk
+        if len(chunk) < 1000:
+            break
+        off += 1000
+    return rows
+
+
+def pnl_at(row, n):
+    """PnL (%) на n-й минуте, если позиция ещё жила; если уже закрыта раньше — итог. None — нет данных."""
+    if (row.get("held_min") or 0) <= n:
+        return row.get("pnl_pct")
+    path = {int(k): v for k, v in (row.get("pnl_path") or {}).items()}
+    ks = [k for k in path if k <= n]
+    return path[max(ks)] if ks else None
+
+
+def usd(row, pnl_pct):
+    return (row.get("amount_usd") or 0.0) * pnl_pct / 100.0
+
+
+def main():
+    rows = [r for r in load() if r.get("pnl_pct") is not None]
+    if not rows:
+        print("Нет закрытых сделок в trade_pnl_path.")
+        return
+    print(f"Сделок: {len(rows)}\n")
+
+    by = defaultdict(list)
+    for r in rows:
+        by[r.get("exit_category") or "OTHER"].append(r)
+
+    print("== По типам выхода ==")
+    print(f"{'тип':10} {'шт':>3} {'итого $':>9} " + " ".join(f"{'мед@'+str(m)+'м':>8}" for m in MARKS))
+    for cat, rs in sorted(by.items(), key=lambda kv: -len(kv[1])):
+        tot = sum(usd(r, r["pnl_pct"]) for r in rs)
+        meds = []
+        for m in MARKS:
+            vals = [v for v in (pnl_at(r, m) for r in rs if (r.get("held_min") or 0) > m) if v is not None]
+            meds.append(f"{st.median(vals):8.1f}" if vals else f"{'-':>8}")
+        print(f"{cat:10} {len(rs):3d} {tot:9.2f} " + " ".join(meds))
+
+    rugs = by.get("RUG", [])
+    if rugs:
+        print("\n== Раги: что было прямо перед сливом ==")
+        for r in rugs:
+            path = r.get("pnl_path") or {}
+            tail = ", ".join(f"{k}м:{v:+.0f}%" for k, v in sorted(path.items(), key=lambda kv: int(kv[0]))[-5:])
+            print(f"{(r.get('symbol') or '?')[:10]:10} held {r.get('held_min')}м, пик {r.get('peak_pnl_pct')}%, "
+                  f"последний тик {r.get('last_tick_pnl_pct')}% за {r.get('secs_since_last_tick')}с до слива | {tail}")
+
+    base = sum(usd(r, r["pnl_pct"]) for r in rows)
+    print(f"\n== Что если выходить раньше (итого $; сейчас {base:.2f}) ==")
+    print(f"{'N мин':>6} {'выйти на N':>12} {'половину на N':>14}  (нет данных: сделок)")
+    for n in EXIT_AT:
+        full = half = 0.0
+        miss = 0
+        for r in rows:
+            a = pnl_at(r, n)
+            if a is None:
+                miss += 1
+                full += usd(r, r["pnl_pct"])
+                half += usd(r, r["pnl_pct"])
+                continue
+            full += usd(r, a)
+            half += usd(r, 0.5 * a + 0.5 * r["pnl_pct"]) if (r.get("held_min") or 0) > n else usd(r, r["pnl_pct"])
+        print(f"{n:6d} {full:12.2f} {half:14.2f}  ({miss})")
+    print("\n'выйти на N' — всё, что живо на N-й минуте, продаётся по PnL этой минуты; 'половину' — продаётся 50%, остаток как есть.")
+
+
+if __name__ == "__main__":
+    main()
