diff --git a/pnl_path_log.py b/pnl_path_log.py
new file mode 100644
index 0000000..5cea97a
--- /dev/null
+++ b/pnl_path_log.py
@@ -0,0 +1,162 @@
+"""Траектория PnL по минутам + выгрузка каждой закрытой сделки в Supabase (таблица trade_pnl_path).
+
+Зачем: по одному итоговому PnL нельзя понять, выгодно ли выходить раньше (например, на 15-й минуте):
+раги случаются через 17-24 минуты после входа, а лучшие ракеты держатся до 25 минут. Нужна кривая PnL.
+
+Как работает:
+  * snap(position, pnl_pct)  — вызывается на каждом тике менеджера позиций (main.py), пишет PnL (%)
+    в ПЕРВЫЙ тик каждой минуты удержания: pnl_path["5"] ~ PnL через 5 минут после входа.
+  * save_on_close(...)       — вызывается из tracker.close_position, кладёт строку в Supabase
+    (фоновый поток, сбой записи никогда не ломает торговлю) и дублирует в pnl_path_log.jsonl.
+
+Таблицу создайте один раз: supabase_trade_pnl_path.sql (Supabase -> SQL Editor).
+Отключить: переменная окружения PNL_PATH_LOG_ENABLED=0.
+"""
+import json
+import threading
+import time
+
+import config
+
+TABLE = "trade_pnl_path"
+MAX_MINUTE = 40          # дальше 40-й минуты кривую не пишем (Max Hold = 25-30 мин)
+LOCAL_FILE = "pnl_path_log.jsonl"
+
+_client = None
+_client_failed = False
+_warned = False
+_lock = threading.Lock()
+
+
+def _enabled() -> bool:
+    return bool(getattr(config, "PNL_PATH_LOG_ENABLED", True))
+
+
+def _sb():
+    global _client, _client_failed
+    if _client is not None or _client_failed:
+        return _client
+    with _lock:
+        if _client is None and not _client_failed:
+            try:
+                url = getattr(config, "SUPABASE_URL", None)
+                key = getattr(config, "SUPABASE_KEY", None)
+                if url and key:
+                    from supabase import create_client
+                    _client = create_client(url, key)
+                else:
+                    _client_failed = True
+            except Exception as e:
+                _client_failed = True
+                print(f"⚠️ [PNL-PATH] Supabase недоступен ({type(e).__name__}): пишу только в {LOCAL_FILE}")
+    return _client
+
+
+def snap(position, pnl_pct, now_ts=None):
+    """Запомнить PnL на тике. pnl_pct — доля (0.12 = +12%). Никогда не бросает исключений."""
+    try:
+        if not _enabled():
+            return
+        now = float(now_ts or time.time())
+        minute = int((now - float(position.entry_time)) / 60.0)
+        if minute < 0 or minute > MAX_MINUTE:
+            return
+        path = getattr(position, "pnl_path", None)
+        if not isinstance(path, dict):
+            path = {}
+            position.pnl_path = path
+        key = str(minute)
+        if key not in path:
+            path[key] = round(float(pnl_pct) * 100.0, 1)
+        # последний известный PnL (для рагов: что было за секунды до слива)
+        position.pnl_last_pct = round(float(pnl_pct) * 100.0, 1)
+        position.pnl_last_ts = now
+    except Exception:
+        pass
+
+
+def _category(reason: str) -> str:
+    r = (reason or "").upper()
+    if "RUG" in r or "LIQUIDITY LOSS" in r or "HONEYPOT" in r or "UNSELLABLE" in r:
+        return "RUG"
+    if "MAX HOLD" in r:
+        return "MAXHOLD"
+    if "INFANT" in r:
+        return "INFANT"
+    if "BREAKEVEN" in r:
+        return "BREAKEVEN"
+    if "TRAILING" in r or "FLOOR" in r or "HARVEST" in r:
+        return "TRAIL"
+    if "STOP" in r or "CAP" in r:
+        return "STOP"
+    return "OTHER"
+
+
+def build_row(pos, pnl_pct, reason):
+    """Собирает строку для таблицы. pnl_pct — итоговая доля (после комиссий), как в tracker."""
+    entry_ts = float(getattr(pos, "entry_time", 0.0) or 0.0)
+    exit_ts = float(getattr(pos, "exit_time", 0.0) or time.time())
+    feats = getattr(pos, "ml_features", None)
+    feats = feats if isinstance(feats, dict) else {}
+    ep = float(getattr(pos, "entry_price_usd", 0.0) or 0.0)
+    mp = float(getattr(pos, "max_price_usd", 0.0) or 0.0)
+    peak = ((mp / ep) - 1.0) * 100.0 if (ep > 0 and mp > 0) else None
+    dd = getattr(pos, "max_dd_pct", None)
+    last_ts = float(getattr(pos, "pnl_last_ts", 0.0) or 0.0)
+    path = getattr(pos, "pnl_path", None)
+    try:
+        feats_json = json.loads(json.dumps(feats, default=str))
+    except Exception:
+        feats_json = {}
+    return {
+        "trade_key": f"{pos.mint}:{int(entry_ts)}",
+        "mint": pos.mint,
+        "symbol": getattr(pos, "symbol", None),
+        "source": (getattr(pos, "source", "") or feats.get("source") or "")[:60],
+        "dex": feats.get("dex"),
+        "entry_ts": entry_ts,
+        "exit_ts": exit_ts,
+        "held_min": round((exit_ts - entry_ts) / 60.0, 2) if entry_ts else None,
+        "amount_usd": float(getattr(pos, "original_amount_usd", 0.0) or getattr(pos, "amount_usd", 0.0) or 0.0),
+        "token_age_at_entry_min": feats.get("age_min"),
+        "liquidity_usd": feats.get("liquidity"),
+        "confidence": float(getattr(pos, "ml_confidence", 0.0) or 0.0),
+        "exit_reason": (reason or "")[:300],
+        "exit_category": _category(reason),
+        "pnl_pct": round(float(pnl_pct) * 100.0, 2),
+        "peak_pnl_pct": round(peak, 1) if peak is not None else None,
+        "trough_pnl_pct": round(float(dd) * 100.0, 1) if isinstance(dd, (int, float)) else None,
+        "last_tick_pnl_pct": getattr(pos, "pnl_last_pct", None),
+        "secs_since_last_tick": round(exit_ts - last_ts, 1) if last_ts else None,
+        "pnl_path": path if isinstance(path, dict) else {},
+        "features": feats_json,
+    }
+
+
+def save_on_close(pos, pnl_pct, reason):
+    """Вызывать после закрытия позиции. Не блокирует и не бросает исключений."""
+    try:
+        if not _enabled():
+            return
+        row = build_row(pos, pnl_pct, reason)
+        try:
+            with open(LOCAL_FILE, "a", encoding="utf-8") as f:
+                f.write(json.dumps(row, ensure_ascii=False) + "\n")
+        except Exception:
+            pass
+        sb = _sb()
+        if not sb:
+            return
+
+        def _bg():
+            global _warned
+            try:
+                sb.table(TABLE).upsert(row, on_conflict="trade_key").execute()
+            except Exception as e:
+                if not _warned:
+                    _warned = True
+                    print(f"⚠️ [PNL-PATH] Не удалось записать в Supabase (таблица {TABLE} создана?): {str(e)[:200]}")
+
+        threading.Thread(target=_bg, daemon=True).start()
+    except Exception as e:
+        print(f"⚠️ [PNL-PATH] save_on_close: {type(e).__name__}: {e}")
diff --git a/supabase_trade_pnl_path.sql b/supabase_trade_pnl_path.sql
new file mode 100644
index 0000000..1237667
--- /dev/null
+++ b/supabase_trade_pnl_path.sql
@@ -0,0 +1,28 @@
+-- Таблица траекторий PnL. Выполните один раз: Supabase -> SQL Editor -> New query -> Run.
+create table if not exists public.trade_pnl_path (
+  trade_key              text primary key,          -- mint:entry_ts (одна строка на сделку)
+  mint                   text not null,
+  symbol                 text,
+  source                 text,                      -- SCANNER / JUP / GROK-JEV ...
+  dex                    text,
+  entry_ts               double precision,          -- unix-время входа
+  exit_ts                double precision,
+  held_min               real,                      -- сколько минут держали
+  amount_usd             real,
+  token_age_at_entry_min real,
+  liquidity_usd          real,
+  confidence             real,
+  exit_reason            text,
