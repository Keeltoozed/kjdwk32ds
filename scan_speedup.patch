+def _ctx_attr(name, default=0.0):
+    """Task-local атрибут анализатора (по экземпляру).
+    analyze_token пишет last_score/_last_top10/_last_dev, а потом их читают дальше по коду
+    (xgboost/raydium-ветки, main.py). При параллельном разборе токенов (scan_pipeline) общий
+    атрибут перезаписывался бы соседними задачами -> скор/признаки одного токена уходили бы
+    в позицию другого. ContextVar даёт каждой asyncio-задаче свою копию."""
+    key = "_cv_" + name
+
+    def _get(self):
+        cv = self.__dict__.get(key)
+        return default if cv is None else cv.get()
+
+    def _set(self, value):
+        cv = self.__dict__.get(key)
+        if cv is None:
+            cv = contextvars.ContextVar(f"{name}_{id(self)}", default=default)
+            self.__dict__[key] = cv
+        cv.set(value)
+
+    return property(_get, _set)
+
+
 class Analyzer:
+    last_score = _ctx_attr("last_score", 0.0)    # Скор последнего решения (для радара)
+    _last_top10 = _ctx_attr("_last_top10", 0.0)  # топ-10 холдеров % (последний разбор в этой задаче)
+    _last_dev = _ctx_attr("_last_dev", 0.0)      # доля дева % (последний разбор в этой задаче)
+
